# ─────────────────────────────────────────────────────────────
# «Наглядно» — конфигурация автопайплайна. Скопируй в .env и заполни.
# .env в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# ── LLM (обязательно) ──────────────────────────────────────
# Ключ Anthropic: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Публикация (нужен ОДИН из вариантов) ───────────────────
# Вариант A — Ayrshare (быстрый старт, обёртка над официальным TikTok API,
#   аудит у них уже пройден). https://www.ayrshare.com/ → API Key.
PUBLISH_PROVIDER=ayrshare
AYRSHARE_API_KEY=
# необязательно, если в аккаунте Ayrshare один профиль:
AYRSHARE_PROFILE_KEY=

# Вариант B — свой TikTok for Developers app (нужен аудит для публичных постов).
#   https://developers.tiktok.com/ → Manage apps. Тогда PUBLISH_PROVIDER=tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ── Хостинг картинок ───────────────────────────────────────
# TikTok скачивает изображения по публичным URL (PULL_URL). Куда заливать PNG.
# Поддержано: s3 (любой S3-совместимый: AWS, Cloudflare R2, Backblaze B2, MinIO).
IMAGE_HOST=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# публичный базовый URL бакета/раздачи, напр. https://cdn.naglyadno.tech
S3_PUBLIC_BASE_URL=

# ── Ревью в Telegram (рекомендуется на старте) ─────────────
# Бот от @BotFather. CHAT_ID — твой личный чат (узнать: @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false = слать превью и ждать кнопку «Постить». true = постить без подтверждения.
AUTO_PUBLISH=false
# сколько ждать реакцию в Telegram, минут (по истечении — отложить, не постить)
APPROVAL_TIMEOUT_MIN=180

# ── Источники трендов (необязательно, без ключей работает HN) ─
# Reddit: https://www.reddit.com/prefs/apps (script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Product Hunt: https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# ── Пайплайн-сервер (его дергает n8n) ─────────────────────
PIPELINE_PORT=8477
# общий секрет: то же значение должно быть в docker-compose.yml (PIPELINE_TOKEN)
PIPELINE_TOKEN=change-me-local-token

# ── Прочее ─────────────────────────────────────────────────
# Часовой пояс для планировщика и логов
TZ=Europe/Kyiv
# Сколько материалов готовит один цикл (1–3)
ITEMS_PER_CYCLE=1
